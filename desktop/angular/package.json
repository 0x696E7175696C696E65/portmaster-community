{
  "name": "portmaster",
  "version": "2.2.3",
  "scripts": {
    "ng": "ng",
    "start": "npm install && npm run build-libs:dev && ng serve --proxy-config ./proxy.json",
    "build-libs": "cross-env NODE_ENV=production ng build --configuration production @safing/ui && cross-env NODE_ENV=production ng build --configuration production @safing/portmaster-api",
    "build-libs:dev": "ng build --configuration development @safing/ui && ng build --configuration development @safing/portmaster-api",
    "build-ui:dev:watch": "ng build --configuration development @safing/ui --watch",
    "build-api:dev:watch": "ng build --configuration development @safing/portmaster-api --watch",
    "serve-with-lib-watch": "ng serve --proxy-config ./proxy.json --poll=2000",
    "serve": "npm run build-libs:dev && ng serve --proxy-config ./proxy.json",
    "build:dev": "npm run build-libs:dev && ng build",
    "test": "ng test",
    "lint": "ng lint",
    "chrome-extension": "cross-env NODE_ENV=production ng build --configuration production portmaster-chrome-extension",
    "chrome-extension:dev": "ng build --configuration development portmaster-chrome-extension --watch",
    "build": "npm run build-libs && cross-env NODE_ENV=production ng build --configuration production --base-href /ui/modules/portmaster/",
    "build-tauri": "npm run build-libs && cross-env NODE_ENV=production ng build --configuration production tauri-builtin",
    "serve-tauri-builtin": "ng serve tauri-builtin --port 4100",
    "serve-app": "ng serve --port 4200 --proxy-config ./proxy.json",
    "tauri-dev": "npm install && run-s build-libs:dev && run-p serve-app serve-tauri-builtin",
    "test:security": "node --test scripts/*security.test.cjs",
    "lint:security": "eslint --no-eslintrc --config .eslintrc.security.json --no-ignore --no-inline-config \"src/**/*.ts\" \"projects/**/*.ts\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/localize": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@ctrl/tinycolor": "^4.1.0",
    "@fortawesome/angular-fontawesome": "4.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-cli": "^2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.1",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "@tauri-apps/plugin-websocket": "^2.3.0",
    "autoprefixer": "^10.4.14",
    "d3": "^7.8.4",
    "data-urls": "^5.0.0",
    "emoji-toolkit": "^10.0.0",
    "fuse.js": "^7.5.0",
    "ng-zorro-antd": "21.3.3",
    "ngx-markdown": "21.3.0",
    "postcss": "^8.5.23",
    "prismjs": "1.30.0",
    "psl": "^1.9.0",
    "rxjs": "~7.8.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tslib": "^2.5.0",
    "whatwg-encoding": "^3.1.1",
    "zone.js": "~0.15.1",
    "marked": "18.0.2"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "21.1.0",
    "@angular-devkit/build-angular": "21.2.24",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@types/chrome": "^0.0.236",
    "@types/d3": "^7.4.0",
    "@types/data-urls": "^3.0.4",
    "@types/jasmine": "^4.3.1",
    "@types/node": "^20.1.5",
    "@types/psl": "^1.1.0",
    "@types/topojson-client": "^3.1.1",
    "@types/topojson-simplify": "^3.0.1",
    "@types/whatwg-encoding": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jasmine-core": "^5.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "js-yaml-loader": "^1.2.2",
    "ng-packagr": "21.2.7",
    "npm-run-all": "^4.1.5",
    "postcss-import": "^15.1.0",
    "postcss-loader": "^7.3.0",
    "postcss-scss": "^4.0.6",
    "tailwindcss": "^3.3.2",
    "ts-node": "^10.9.1",
    "typescript": "5.9.3",
    "webpack-bundle-analyzer": "^4.8.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "piscina": "5.3.2",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
