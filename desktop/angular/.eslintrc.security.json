{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.property.name=/^bypassSecurityTrust/]",
        "message": "Preserve Angular sanitization for API, profile and notification content."
      }
    ]
  }
}
